{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{execFileSync}=require('node:child_process');const{pathToFileURL}=require('node:url');import(pathToFileURL(execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/.codex/hooks/guard-generated.mjs').href)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{execFileSync}=require('node:child_process');const{pathToFileURL}=require('node:url');import(pathToFileURL(execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/.codex/hooks/validate-doc.mjs').href)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
