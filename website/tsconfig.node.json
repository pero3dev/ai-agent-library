{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["lib/**/*.mjs", "lib/**/*.mts", "lib/**/*.ts", "scripts/**/*.mjs", "scripts/**/*.mts", "scripts/**/*.cjs", "next.config.mjs", "playwright.config.mjs"],
  "exclude": ["node_modules", "generated", "vendor", "out"]
}
