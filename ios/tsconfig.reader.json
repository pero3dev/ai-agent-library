{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  },
  "include": ["renderer/reader.ts", "renderer/**/*.d.ts"],
  "exclude": ["node_modules", "DerivedData", "build"]
}
