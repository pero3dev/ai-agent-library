{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.mjs", "**/*.mts", "**/*.ts", "../.codex/hooks/*.mjs", "../.codex/hooks/*.mts", "../.claude/hooks/*.mjs", "../.claude/hooks/*.mts"],
  "exclude": ["../node_modules", "../.local", "lib/ios-*.mjs", "lib/ios-*.mts", "build-ios-*.mjs", "build-ios-*.mts"]
}
